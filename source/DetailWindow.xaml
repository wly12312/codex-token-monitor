<Window x:Class="CodexTokenMonitor.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex usage · Task details" Icon="Assets/AppIcon.ico" Width="232" Height="284"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Margin="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource PanelBrush}">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/><RowDefinition Height="24"/><RowDefinition Height="18"/>
                <RowDefinition Height="46"/><RowDefinition Height="44"/><RowDefinition Height="40"/>
                <RowDefinition Height="28"/><RowDefinition Height="22"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="任务概览" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="BackButton" Content="返回" HorizontalAlignment="Right" Width="39" Height="24" FontSize="10" Padding="0"
                        AutomationProperties.Name="返回主界面" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
            <TextBlock x:Name="TaskTitle" Grid.Row="1" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock x:Name="TaskCounts" Grid.Row="2" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,3,0,0">
                <StackPanel><TextBlock Text="输入" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InputValue" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel><TextBlock Text="缓存" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CachedValue" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{StaticResource TealBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel><TextBlock Text="输出" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OutputValue" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{StaticResource PurpleBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
            </UniformGrid>
            <UniformGrid Grid.Row="4" Columns="2" Margin="0,3,0,0">
                <StackPanel><TextBlock Text="预估 credits" FontSize="9" Foreground="{StaticResource MutedBrush}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="21"><TextBlock x:Name="CreditsValue" FontSize="14" FontWeight="SemiBold"/></Viewbox></StackPanel>
                <StackPanel><TextBlock Text="API 等价值" FontSize="9" Foreground="{StaticResource MutedBrush}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="21"><TextBlock x:Name="ApiValue" FontSize="14" FontWeight="SemiBold"/></Viewbox></StackPanel>
            </UniformGrid>
            <Border Grid.Row="5" Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="6,2">
                <Grid TextBlock.FontSize="9">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="所选" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="RequestedModelValue" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="返回" Grid.Row="1" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ReturnedModelValue" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <StackPanel x:Name="ContextPanel" Grid.Row="6" Margin="0,4,0,0">
                <Grid><TextBlock Text="Context*" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ContextValue" FontSize="9" HorizontalAlignment="Right"/></Grid>
                <ProgressBar x:Name="ContextBar" Height="3" Minimum="0" Maximum="100" Margin="0,3,0,0" Foreground="{StaticResource TealBrush}" Background="#E9ECF1" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="UpdatedText" Grid.Row="7" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="EstimateNote" Grid.Row="8" FontSize="8" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
